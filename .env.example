# Copy to .env (gitignored) only to run a script's commands by hand without Secrets Manager;
# load it with
#   set -a; . ./.env; set +a
# Every private value lives in Bitwarden Secrets Manager (BWS), read by name (sys-admin#194):
# scripts/private-value.sh <KEY> prints the variable below if it is set, else the BWS secret
# of the same name. No workflow in this repository reads any of them: CI runs on GitHub-hosted
# runners with only the read-only GITHUB_TOKEN, so it needs no BWS_ACCESS_TOKEN Actions secret.

# The BWS machine account's (or the owner's) access token. Needed whenever a value below is
# blank. On the owner's hosts it is in ~/.bws_token.
BWS_ACCESS_TOKEN=

# Tailscale addresses of the nodes (scripts/syncthing, skills/syncthing-pair).
# BWS secret SYS_ADMIN_TAILSCALE_IP_WSL: the WSL2 node's tailnet address
SYS_ADMIN_TAILSCALE_IP_WSL=
# BWS secret SYS_ADMIN_TAILSCALE_IP_LAPTOP: the Windows host's tailnet address
SYS_ADMIN_TAILSCALE_IP_LAPTOP=
# BWS secret SYS_ADMIN_TAILSCALE_IP_HOMELAB: the homelab server's tailnet address
SYS_ADMIN_TAILSCALE_IP_HOMELAB=
# BWS secret SYS_ADMIN_TAILSCALE_IP_IPHONE: the iPhone's tailnet address (SyncTrain and VaultSync)
SYS_ADMIN_TAILSCALE_IP_IPHONE=

# Tailscale MagicDNS names (the tailnet name is private).
# BWS secret SYS_ADMIN_TAILSCALE_HOST_WSL: the WSL2 node's full MagicDNS name
SYS_ADMIN_TAILSCALE_HOST_WSL=
# BWS secret SYS_ADMIN_TAILSCALE_HOST_VAULTWARDEN: the full MagicDNS name Vaultwarden's Tailscale Serve uses
SYS_ADMIN_TAILSCALE_HOST_VAULTWARDEN=

# Syncthing device IDs (scripts/syncthing/pair-device.sh); the docs name a device by its
# 7-character prefix only.
# BWS secret SYS_ADMIN_SYNCTHING_DEVICE_ID_WSL2: the WSL2 node's full device ID
SYS_ADMIN_SYNCTHING_DEVICE_ID_WSL2=
# BWS secret SYS_ADMIN_SYNCTHING_DEVICE_ID_WINDOWS: the Windows host's full device ID
SYS_ADMIN_SYNCTHING_DEVICE_ID_WINDOWS=
# BWS secret SYS_ADMIN_SYNCTHING_DEVICE_ID_IPHONE: the iPhone's (SyncTrain) full device ID
SYS_ADMIN_SYNCTHING_DEVICE_ID_IPHONE=
